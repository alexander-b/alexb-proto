{
 "headers": [
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "alexb-proto-v2.vercel.app"
    }
   ],
   "destination": "/v2/",
   "permanent": false
  }
 ]
}